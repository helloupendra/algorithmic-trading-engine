{
  "//": "Committed defaults ONLY. Never put real credentials in this file \u2014 it is tracked by git. Real values belong in the git-ignored appsettings.Local.json, which scripts/setup.sh|ps1 generates from the repo-root .env.",
  "ConnectionStrings": {
    "TradingDb": "Host=localhost;Port=5432;Database=algotrading;Username=postgres;Password=CHANGE_ME"
  },
  "MarketDataWorker": {
    "Symbols": [
      "NSE:SBIN-EQ"
    ],
    "Resolution": "D",
    "LookbackDays": 5,
    "IntervalMinutes": 15
  },
  "Jwt": {
    "Issuer": "AlgoTrading.Api",
    "Audience": "AlgoTrading.App",
    "SecretKey": "REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Fyers": {
    "ClientId": "",
    "SecretKey": "",
    "RedirectUri": "http://127.0.0.1:5025/api/auth/callback",
    "DataApiBaseUrl": "https://api-t1.fyers.in"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RiskManagement": {
    "MaxOrdersPerMinute": 50,
    "MaxDailyLoss": -50000.0
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}