###############################################################################
# AlgoTrading — single source of truth for local configuration
#
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows)
#
# Then fill in the real values. `.env` is git-ignored and must NEVER be
# committed. `scripts/setup.sh` / `scripts/setup.ps1` read this file and
# generate the matching `appsettings.Local.json` for the .NET projects, so you
# only ever edit values in one place.
#
# Consumed by:
#   - docker/docker-compose.yml      (Postgres/Redis/Grafana containers)
#   - src/AlgoTrading.Api            (via generated appsettings.Local.json)
#   - src/AlgoTrading.Worker.*       (via generated appsettings.Local.json)
#   - src/AlgoTrading.PythonEngine   (via core/config.py -> python-dotenv)
###############################################################################

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# -----------------------------------------------------------------------------
# These create the container on first `docker compose up`. If you change the
# password after the volume already exists you must also recreate the volume
# (`docker compose down -v`), otherwise Postgres keeps the original password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=algotrading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Leave empty for a local container that is not exposed beyond localhost.
# REQUIRED if Redis is reachable from anywhere else.
REDIS_PASSWORD=

# Tick transport stream. MAXLEN caps memory use: older entries are evicted once
# the cap is reached, so size it to your session volume.
REDIS_STREAM_NAME=market:ticks
REDIS_STREAM_MAXLEN=500000

# -----------------------------------------------------------------------------
# FYERS broker API
# -----------------------------------------------------------------------------
# Create an app at https://myapi.fyers.in/dashboard to obtain these.
# The redirect URI below must match the one registered on that dashboard
# character for character, or the OAuth callback will be rejected.
FYERS_APP_ID=YOUR_FYERS_APP_ID
FYERS_SECRET_KEY=YOUR_FYERS_SECRET_KEY
FYERS_REDIRECT_URI=http://127.0.0.1:5025/api/auth/callback
FYERS_DATA_API_BASE_URL=https://api-t1.fyers.in

# -----------------------------------------------------------------------------
# JWT signing (AlgoTrading.Api)
# -----------------------------------------------------------------------------
# Must be at least 32 characters. Generate a fresh one — do not reuse the
# example. `scripts/setup.sh` will generate one automatically if left as-is.
#   macOS/Linux:  openssl rand -base64 48
#   Windows:      [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=AlgoTrading.Api
JWT_AUDIENCE=AlgoTrading.App
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# -----------------------------------------------------------------------------
# Admin bootstrap (AlgoTrading.Api)
# -----------------------------------------------------------------------------
# On first start the API ensures one Admin account exists. Leave the password
# blank and a strong one is generated and printed to the API console ONCE —
# copy it out, or set it here to pin it. Never reuse a password across
# environments.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Python engine service account
# -----------------------------------------------------------------------------
# Every API endpoint requires a bearer token, so the engine signs in as this
# dedicated Trader account. The API provisions it on startup from these values;
# the engine reads the same two keys to log in. Both must be set or the engine
# cannot reach the API. Generate a long random password:
#   openssl rand -base64 32
ENGINE_SERVICE_USERNAME=engine-service
ENGINE_SERVICE_PASSWORD=

# -----------------------------------------------------------------------------
# Web client (CORS)
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. The Vite dev
# server runs on 5173. Add your production origin here before deploying —
# wildcards are deliberately not supported.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Backend API (read by the Python engine and the import scripts)
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:5025

# TLS verification for outbound calls from the Python engine. Keep True unless
# you are on a pure loopback setup — False disables certificate validation.
VERIFY_SSL=True

# Verbose tick logging. Useful while developing, very noisy in a live session.
DEBUG_PRINT_MESSAGES=False

# -----------------------------------------------------------------------------
# Risk limits (AlgoTrading.Api)
# -----------------------------------------------------------------------------
RISK_MAX_ORDERS_PER_MINUTE=50
RISK_MAX_DAILY_LOSS=-50000

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
