*.pfx
*.p12
secrets.json

# ---------------------------------------------------------------------------
# Private / personal — local only, never published
# ---------------------------------------------------------------------------
# Personal strategy scripts. These stay on the developer's machine; the logic
# they contain is already implemented inside src/AlgoTrading.PythonEngine.
reference/
private/
src/AlgoTrading.PythonEngine/strategies/titli/

# ---------------------------------------------------------------------------
# Generated data — re-fetched by scripts/setup.*, never committed
# ---------------------------------------------------------------------------
# FYERS instrument masters (~18 MB, refreshed daily by the broker).
# scripts/fetch-instruments.* downloads current copies into data/instruments/.
data/instruments/*.csv
data/**/*.parquet
data/**/*.db

