# The isolation contract of the local dev stack (scripts/dev/local-live.sh).
#
# The dev API is started from an EMPTY environment (env -i) holding exactly
# these lines plus the few the script computes (ports, paths, the throwaway
# database's password, the generated sign-in passwords). Nothing from the
# shell, from the repo-root .env or from src/AlgoTrading.Api/appsettings.Local.json
# reaches it: its content root is .dev-live/content/api, where no Local.json
# exists, so the file that holds the real broker keys is never read.
#
# Why this file exists at all: production trades live on the owner's Dhan and
# FYERS accounts. A second API that signs in to Dhan with the PIN and TOTP ends
# the server's token; a second Dhan websocket disconnects the first; FYERS,
# Angel and TrueData behave the same way. So the dev API must be UNABLE to
# reach a broker, not merely configured not to.
#
# Committed on purpose, and it holds no secret: every broker value here is
# empty, a switch set to off, or the closed port http://127.0.0.1:9. The script
# refuses to start the API if a credential below is ever given a value, or if a
# URL below points anywhere else (scripts/tests/local-live.test.sh checks the
# same in CI). Format: KEY=VALUE, one per line, no quotes, no expansion.

# --- 1. Every broker and vendor credential: empty ---------------------------
# Both spellings each connector reads: the section key, and the environment
# variable its registration falls back to when the section key is absent.
Fyers__ClientId=
Fyers__SecretKey=
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
Dhan__ClientId=
Dhan__ApiKey=
Dhan__ApiSecret=
Dhan__AccessToken=
Dhan__Pin=
Dhan__TotpSecret=
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=
TrueData__Username=
TrueData__Password=
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
Angel__ApiKey=
Angel__ClientCode=
Angel__Pin=
Angel__TotpSecret=
Angel__StaticIp=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_STATIC_IP=
SimBroker__AdminKey=
SimBroker__ClientId=
SimBroker__AppId=
SimBroker__AppSecret=
SimBroker__TotpSecret=
SimBroker__StaticIp=
SIMBROKER_ADMIN_KEY=
SIMBROKER_CLIENT_ID=
SIMBROKER_APP_ID=
SIMBROKER_APP_SECRET=
SIMBROKER_TOTP_SECRET=
SIMBROKER_STATIC_IP=
Telegram__BotToken=
Telegram__ChatId=
Telegram__SystemChatId=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SYSTEM_CHAT_ID=

# --- 2. Nothing starts by itself --------------------------------------------
# The daily Dhan PIN + TOTP sign-in (also idle without the secrets above).
Dhan__AutoSignIn__Enabled=false
# Dhan's minute option-chain recorder.
Dhan__ChainPoller__Enabled=false
DHAN_CHAIN_POLLER_ENABLED=false
# The switch from a silent Dhan feed to FYERS.
FeedFailover__Enabled=false
FeedFailover__DryRun=true
# News, NSE filings, global cues, breadth and their backfills (NSE, Yahoo, RSS).
MarketIntelligence__NewsEnabled=false
MarketIntelligence__AnnouncementsEnabled=false
MarketIntelligence__QuoteSnapshotsEnabled=false
MarketIntelligence__GlobalDailyEnabled=false
MarketIntelligence__BreadthEnabled=false
MarketIntelligence__BackfillEnabled=false
MarketIntelligence__NewsScoringEnabled=false
# NSE's evening market-factor files.
MarketFactors__SyncEnabled=false
# The Analysis module's 08:50 / 15:50 Python jobs.
Forecasts__SchedulerEnabled=false
# Candle-pattern alerts to Telegram.
PatternAlerts__Enabled=false

# --- 3. Every broker and vendor address: a closed local port ----------------
Fyers__DataApiBaseUrl=http://127.0.0.1:9
Fyers__RedirectUri=http://127.0.0.1:9/fyers-disabled-in-dev
Dhan__ApiBaseUrl=http://127.0.0.1:9
Dhan__AuthBaseUrl=http://127.0.0.1:9
Dhan__InstrumentMasterUrl=http://127.0.0.1:9/dhan-master-disabled-in-dev.csv
Dhan__FeedUrl=ws://127.0.0.1:9
Dhan__RedirectUri=http://127.0.0.1:9/dhan-disabled-in-dev
TrueData__AuthBaseUrl=http://127.0.0.1:9
TrueData__HistoryBaseUrl=http://127.0.0.1:9
TrueData__SymbolApiBaseUrl=http://127.0.0.1:9
TrueData__GreeksBaseUrl=http://127.0.0.1:9
TrueData__StreamHost=127.0.0.1
TrueData__RealTimePort=9
Angel__RootUrl=http://127.0.0.1:9
ANGEL_ROOT_URL=http://127.0.0.1:9
SimBroker__BaseUrl=http://127.0.0.1:9
SIMBROKER_BASE_URL=http://127.0.0.1:9

# --- 4. Anything else that would leave the machine --------------------------
# A few URLs are compiled in rather than configured (FYERS's token endpoints,
# its public symbol masters, Telegram, NSE, Yahoo, the news feeds, the AWS
# metadata address). .NET's HttpClient sends every request through
# HTTP(S)_PROXY, so pointing the proxy at the closed port fails them all at
# once. Loopback is exempt, which is where the database and Redis are.
HTTP_PROXY=http://127.0.0.1:9
HTTPS_PROXY=http://127.0.0.1:9
ALL_PROXY=http://127.0.0.1:9
http_proxy=http://127.0.0.1:9
https_proxy=http://127.0.0.1:9
all_proxy=http://127.0.0.1:9
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1
